{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ufuk-deger/arac-kronik-db/schema/araclar.schema.json",
  "title": "Araç kronik sorun veritabanı",
  "type": "object",
  "required": [
    "arac_listesi"
  ],
  "additionalProperties": false,
  "properties": {
    "aileler": {
      "description": "Motor ve şanzıman aileleri: birden çok modelde ortak görülen sorunlar bir kez yazılır, araç kayıtları 'aileler' alanıyla bu sorunlara bağlanır.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/aile"
      }
    },
    "arac_listesi": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arac"
      }
    }
  },
  "$defs": {
    "metin": {
      "type": "string",
      "minLength": 1
    },
    "arac": {
      "type": "object",
      "required": [
        "marka",
        "model",
        "motor",
        "uretim_yillari",
        "kronik_sorunlar"
      ],
      "additionalProperties": false,
      "properties": {
        "marka": {
          "$ref": "#/$defs/metin"
        },
        "model": {
          "$ref": "#/$defs/metin"
        },
        "motor": {
          "description": "Motor/şanzıman sürümü. Motordan bağımsız, yalnızca modele (nesle) özgü sorunlar (kasa, sızdırmazlık, iç mekân, elektronik, süspansiyon) için sabit değer: 'Tüm motorlar (model geneli)'.",
          "type": "string",
          "minLength": 1
        },
        "uretim_yillari": {
          "description": "Bu model ve motor kombinasyonunun üretim veya Türkiye satış yılları.",
          "type": "object",
          "required": [
            "baslangic",
            "bitis"
          ],
          "additionalProperties": false,
          "properties": {
            "baslangic": {
              "$ref": "#/$defs/yil"
            },
            "bitis": {
              "$ref": "#/$defs/yil_bitis"
            }
          }
        },
        "kronik_sorunlar": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/sorun"
          },
          "description": "Bu modele ve motora özgü bildirimlerle desteklenen sorunlar. Kayıt yalnızca ailelerine dayanıyorsa boş olabilir."
        },
        "aileler": {
          "description": "Bu kaydın bağlı olduğu motor/şanzıman aileleri (aileler listesindeki kimlikler). Ailelerin ortak sorunları bu kayıtta da gösterilir.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/kimlik"
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "kronik_sorunlar": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "aileler"
          ]
        }
      ],
      "if": {
        "properties": {
          "motor": {
            "const": "Tüm motorlar (model geneli)"
          }
        },
        "required": [
          "motor"
        ]
      },
      "then": {
        "properties": {
          "kronik_sorunlar": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "aileler"
          ]
        }
      },
      "else": {
        "properties": {
          "kronik_sorunlar": {
            "items": {
              "required": [
                "tahmini_km_araligi"
              ]
            }
          }
        }
      }
    },
    "sorun": {
      "type": "object",
      "required": [
        "sorun_adi",
        "etkilenen_parca",
        "belirtiler",
        "risk_seviyesi",
        "kaynaklar"
      ],
      "additionalProperties": false,
      "properties": {
        "sorun_adi": {
          "$ref": "#/$defs/metin"
        },
        "etkilenen_parca": {
          "$ref": "#/$defs/metin"
        },
        "belirtiler": {
          "$ref": "#/$defs/metin"
        },
        "tahmini_km_araligi": {
          "description": "Kaynaklarda bildirilen kilometre aralığı. Motor kayıtlarında zorunludur (kaynaklarından biri tek başına yeterli sayılan bir siteyse, yazıda kilometre yoksa boş bırakılır); model geneli kayıtlarda (motor: 'Tüm motorlar (model geneli)') yaşa ve kullanıma bağlı sorunlar için kaynaklarda kilometre yoksa boş bırakılır, aralık uydurulmaz.",
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{3})* - \\d{1,3}(\\.\\d{3})* km$"
        },
        "risk_seviyesi": {
          "enum": [
            "Düşük",
            "Orta",
            "Yüksek"
          ]
        },
        "kaynaklar": {
          "description": "Sorunu destekleyen sayfalar. En az iki farklı alan adı gerekir; kaynaklardan biri data/kaynaklar.json içinde 'tek_basina_yeterli' işaretli bir siteye aitse tek kaynak yeter. Bu kural scripts/dogrula.py tarafından denetlenir.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "donem_kirilimi": {
          "description": "Sorunun üretim yıllarına göre durumu (ör. revizyon öncesi ve sonrası). Kaynaklar yıl bazlı fark belirtiyorsa doldurulur.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "baslangic",
              "bitis",
              "durum",
              "not"
            ],
            "additionalProperties": false,
            "properties": {
              "baslangic": {
                "$ref": "#/$defs/yil"
              },
              "bitis": {
                "$ref": "#/$defs/yil_bitis"
              },
              "durum": {
                "enum": [
                  "Yaygın",
                  "Görülebilir",
                  "Seyrek"
                ]
              },
              "not": {
                "$ref": "#/$defs/metin"
              }
            }
          }
        },
        "detay": {
          "description": "Sorunun ayrıntıları: nedeni, nasıl anlaşıldığı, yaygın çözümü, bildirilen maliyet ve önlem. Kaynaklardaki kullanıcı, usta ve rehber anlatımlarına dayanır; resmî servis bilgisi değildir.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "neden": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "teshis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "cozum": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "maliyet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "onlem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          }
        },
        "aile_sorunu": {
          "description": "Bu sorunun, bağlı olunan ailenin hangi ortak sorununa karşılık geldiği ('aile_id/sorun_id'). Kayıtta o sorun için modele özgü kaynak olduğunu gösterir; görüntüleyici aile sorununu ayrıca göstermez.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$"
        }
      }
    },
    "yil": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "yil_bitis": {
      "description": "Bitiş yılı; null ise üretim veya dönem sürüyor demektir.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1990,
      "maximum": 2100
    },
    "kimlik": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aile_sorunu": {
      "type": "object",
      "required": [
        "id",
        "sorun_adi",
        "etkilenen_parca",
        "belirtiler",
        "risk_seviyesi",
        "kaynaklar"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/kimlik"
        },
        "sorun_adi": {
          "$ref": "#/$defs/metin"
        },
        "etkilenen_parca": {
          "$ref": "#/$defs/metin"
        },
        "belirtiler": {
          "$ref": "#/$defs/metin"
        },
        "tahmini_km_araligi": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{3})* - \\d{1,3}(\\.\\d{3})* km$"
        },
        "risk_seviyesi": {
          "enum": [
            "Düşük",
            "Orta",
            "Yüksek"
          ]
        },
        "kaynaklar": {
          "description": "Sorunu destekleyen sayfalar. En az iki farklı alan adı gerekir; kaynaklardan biri data/kaynaklar.json içinde 'tek_basina_yeterli' işaretli bir siteye aitse tek kaynak yeter. Bu kural scripts/dogrula.py tarafından denetlenir.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "donem_kirilimi": {
          "description": "Sorunun üretim yıllarına göre durumu (ör. revizyon öncesi ve sonrası). Kaynaklar yıl bazlı fark belirtiyorsa doldurulur.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "baslangic",
              "bitis",
              "durum",
              "not"
            ],
            "additionalProperties": false,
            "properties": {
              "baslangic": {
                "$ref": "#/$defs/yil"
              },
              "bitis": {
                "$ref": "#/$defs/yil_bitis"
              },
              "durum": {
                "enum": [
                  "Yaygın",
                  "Görülebilir",
                  "Seyrek"
                ]
              },
              "not": {
                "$ref": "#/$defs/metin"
              }
            }
          }
        },
        "detay": {
          "description": "Sorunun ayrıntıları: nedeni, nasıl anlaşıldığı, yaygın çözümü, bildirilen maliyet ve önlem. Kaynaklardaki kullanıcı, usta ve rehber anlatımlarına dayanır; resmî servis bilgisi değildir.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "neden": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "teshis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "cozum": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "maliyet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "onlem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          }
        }
      }
    },
    "aile": {
      "type": "object",
      "required": [
        "id",
        "ad",
        "tur",
        "aciklama",
        "kronik_sorunlar"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/kimlik"
        },
        "ad": {
          "$ref": "#/$defs/metin"
        },
        "tur": {
          "enum": [
            "motor",
            "sanziman",
            "sistem"
          ]
        },
        "aciklama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Ailenin ne olduğu ve hangi modellerde kullanıldığı (kısa bilgi notu; kaynak kuralı sorunlar için geçerlidir)."
        },
        "kronik_sorunlar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/aile_sorunu"
          }
        }
      }
    }
  }
}
