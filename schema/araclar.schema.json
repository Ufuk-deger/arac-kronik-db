{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ufuk-deger/arac-kronik-db/schema/araclar.schema.json",
  "title": "Araç kronik sorun veritabanı",
  "type": "object",
  "required": ["arac_listesi"],
  "additionalProperties": false,
  "properties": {
    "arac_listesi": {
      "type": "array",
      "items": { "$ref": "#/$defs/arac" }
    }
  },
  "$defs": {
    "metin": {
      "type": "string",
      "minLength": 1
    },
    "arac": {
      "type": "object",
      "required": ["marka", "model", "motor", "kronik_sorunlar"],
      "additionalProperties": false,
      "properties": {
        "marka": { "$ref": "#/$defs/metin" },
        "model": { "$ref": "#/$defs/metin" },
        "motor": { "$ref": "#/$defs/metin" },
        "kronik_sorunlar": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sorun" }
        }
      }
    },
    "sorun": {
      "type": "object",
      "required": [
        "sorun_adi",
        "etkilenen_parca",
        "belirtiler",
        "tahmini_km_araligi",
        "risk_seviyesi"
      ],
      "additionalProperties": false,
      "properties": {
        "sorun_adi": { "$ref": "#/$defs/metin" },
        "etkilenen_parca": { "$ref": "#/$defs/metin" },
        "belirtiler": { "$ref": "#/$defs/metin" },
        "tahmini_km_araligi": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{3})* - \\d{1,3}(\\.\\d{3})* km$"
        },
        "risk_seviyesi": {
          "enum": ["Düşük", "Orta", "Yüksek"]
        }
      }
    }
  }
}
