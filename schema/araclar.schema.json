{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ufuk-deger/arac-kronik-db/schema/araclar.schema.json",
  "title": "Araç kronik sorun veritabanı",
  "type": "object",
  "required": [
    "arac_listesi"
  ],
  "additionalProperties": false,
  "properties": {
    "arac_listesi": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/arac"
      }
    }
  },
  "$defs": {
    "metin": {
      "type": "string",
      "minLength": 1
    },
    "arac": {
      "type": "object",
      "required": [
        "marka",
        "model",
        "motor",
        "uretim_yillari",
        "kronik_sorunlar"
      ],
      "additionalProperties": false,
      "properties": {
        "marka": {
          "$ref": "#/$defs/metin"
        },
        "model": {
          "$ref": "#/$defs/metin"
        },
        "motor": {
          "$ref": "#/$defs/metin"
        },
        "uretim_yillari": {
          "description": "Bu model ve motor kombinasyonunun üretim veya Türkiye satış yılları.",
          "type": "object",
          "required": [
            "baslangic",
            "bitis"
          ],
          "additionalProperties": false,
          "properties": {
            "baslangic": {
              "$ref": "#/$defs/yil"
            },
            "bitis": {
              "$ref": "#/$defs/yil_bitis"
            }
          }
        },
        "kronik_sorunlar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sorun"
          }
        }
      }
    },
    "sorun": {
      "type": "object",
      "required": [
        "sorun_adi",
        "etkilenen_parca",
        "belirtiler",
        "tahmini_km_araligi",
        "risk_seviyesi",
        "kaynaklar"
      ],
      "additionalProperties": false,
      "properties": {
        "sorun_adi": {
          "$ref": "#/$defs/metin"
        },
        "etkilenen_parca": {
          "$ref": "#/$defs/metin"
        },
        "belirtiler": {
          "$ref": "#/$defs/metin"
        },
        "tahmini_km_araligi": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{3})* - \\d{1,3}(\\.\\d{3})* km$"
        },
        "risk_seviyesi": {
          "enum": [
            "Düşük",
            "Orta",
            "Yüksek"
          ]
        },
        "kaynaklar": {
          "description": "Sorunu destekleyen sayfalar. En az iki farklı alan adı gerekir; bu kural scripts/dogrula.py tarafından denetlenir.",
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[^\\s]+$"
          }
        },
        "donem_kirilimi": {
          "description": "Sorunun üretim yıllarına göre durumu (ör. revizyon öncesi ve sonrası). Kaynaklar yıl bazlı fark belirtiyorsa doldurulur.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "baslangic",
              "bitis",
              "durum",
              "not"
            ],
            "additionalProperties": false,
            "properties": {
              "baslangic": {
                "$ref": "#/$defs/yil"
              },
              "bitis": {
                "$ref": "#/$defs/yil_bitis"
              },
              "durum": {
                "enum": [
                  "Yaygın",
                  "Görülebilir",
                  "Seyrek"
                ]
              },
              "not": {
                "$ref": "#/$defs/metin"
              }
            }
          }
        },
        "detay": {
          "description": "Sorunun ayrıntıları: nedeni, nasıl anlaşıldığı, yaygın çözümü, bildirilen maliyet ve önlem. Kaynaklardaki kullanıcı, usta ve rehber anlatımlarına dayanır; resmî servis bilgisi değildir.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "neden": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "teshis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "cozum": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "maliyet": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            },
            "onlem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 800
            }
          }
        }
      }
    },
    "yil": {
      "type": "integer",
      "minimum": 1990,
      "maximum": 2100
    },
    "yil_bitis": {
      "description": "Bitiş yılı; null ise üretim veya dönem sürüyor demektir.",
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1990,
      "maximum": 2100
    }
  }
}
